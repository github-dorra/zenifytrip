# ══════════════════════════════════════════════════════════════════════════════
# ZenifyTrip — Variables d'environnement (copier vers .env et remplir)
# ══════════════════════════════════════════════════════════════════════════════

# ── API interne agence ────────────────────────────────────────────────────────
API_KEY=<bearer_token_staging>
TRAVELER_API_URL=https://api.staging.zenifytrip.com/api/travellers/UserId
TRAVELLER_MANAGEMENT=https://api.staging.zenifytrip.com/api/traveller-management
HOTEL_API_URL=https://api.staging.zenifytrip.com/api/hotels
HOTEL_SERVICE_API_URL=https://api.staging.zenifytrip.com/api/hotel-services
ZONES_API_URL=https://api.staging.zenifytrip.com/api/zones
FLIGHTS_API_URL=https://api.staging.zenifytrip.com/api/flights
AIRPORTS_API_URL=https://api.staging.zenifytrip.com/api/airports
AIRLINES_API_URL=https://api.staging.zenifytrip.com/api/airline-companies
BOOKINGS_API_URL=https://api.staging.zenifytrip.com/api/bookings
ACTIVITIES_API_URL=https://api.staging.zenifytrip.com/api/activities

# ── LLM — Gemini (principal, 1500 req/jour gratuit) ──────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>

# ── LLM — Groq (fallback automatique sur quota Gemini épuisé) ────────────────
GROQ_API_KEY=<your_groq_api_key>


# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=zenifytrip

# ── Redis (géré par docker-compose — laisser ces valeurs) ────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_ENV=staging

# ── APIs externes ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=<your_openweather_key>
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
GOOGLE_MAPS_API_KEY=<your_google_maps_key>
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
SERPAPI_KEY=<your_serpapi_key>

# ── Tavily Search (dynamic_factual — visa, prix entrée, horaires) ─────────────
TAVILY_API_KEY=<your_tavily_key>
TAVILY_TIMEOUT_SECONDS=5
TAVILY_MAX_RESULTS=3

# ── Paramètres ranking ────────────────────────────────────────────────────────
USER_SCORE_WEIGHT=0.70
BUSINESS_SCORE_WEIGHT=0.30

# ── Restaurant Tier 2 ─────────────────────────────────────────────────────────
RESTAURANT_TIER2_PROVIDER=serpapi
RESTAURANT_MONGO_MIN_RESULTS=3

# ── Scoring availability ──────────────────────────────────────────────────────
AVAILABILITY_AGENCY_STRONG_THRESHOLD=0.60
AVAILABILITY_UNKNOWN_FACTOR_PROTECTED=0.60
AVAILABILITY_UNKNOWN_FACTOR_OPEN=0.90

# ── Session / cache ───────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=1800
WEATHER_CACHE_TTL_SECONDS=7200
INTERACTIONS_REDIS_TTL_SECONDS=2592000
CROSS_SESSION_LIKED_BOOST=1.15

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
